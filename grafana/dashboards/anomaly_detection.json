{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.15 }
          ]},
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Current Anomaly Rate",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "current_anomaly_rate", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 1 }
        ]}
      }},
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Model Loaded",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "model_loaded", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "title": "Requests / sec",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(anomaly_predictions_total[1m])", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }
        ]}
      }},
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background" },
      "title": "P99 Inference Latency",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.99, rate(model_inference_latency_seconds_bucket[5m])) * 1000", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value" },
      "title": "Total Anomalies",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "anomaly_predictions_total{result=\"anomaly\"}", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value" },
      "title": "Total Transactions Scored",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "sum(anomaly_predictions_total)", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "title": "Predictions Over Time",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(anomaly_predictions_total{result=\"normal\"}[1m])", "legendFormat": "Normal", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(anomaly_predictions_total{result=\"anomaly\"}[1m])", "legendFormat": "Anomaly", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "title": "Inference Latency Percentiles",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(model_inference_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P50", "refId": "A" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(model_inference_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P95", "refId": "B" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.99, rate(model_inference_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 9,
      "title": "Anomaly Types Detected",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(anomaly_predictions_by_type_total[5m])", "legendFormat": "{{anomaly_type}}", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 10,
      "title": "Fraud Rules Triggered",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(fraud_rule_triggers_total[5m])", "legendFormat": "{{rule_name}} ({{severity}})", "refId": "A" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["mlops", "anomaly-detection", "fraud"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Anomaly Detection — MLOps Dashboard",
  "uid": "anomaly-detection-mlops",
  "version": 1
}
